.env
.env.*
.dev.vars
.dev.vars.*
.wrangler/
# 任何以 .local 结尾的本地配置
*.local
# 自己起名的私密配置（按需放这里，名字带 secret/密钥/配置-私密 的）
config.secret.*
*.secret.json
密钥.txt
私密配置.*
